{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "context-router", "args": ["hook"], "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Bash|PowerShell|Grep",
        "hooks": [
          { "type": "command", "command": "context-router", "args": ["hook"], "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "context-router", "args": ["hook"], "timeout": 10 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "context-router", "args": ["hook"], "timeout": 10 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "context-router", "args": ["hook"], "timeout": 10 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "context-router", "args": ["hook"], "timeout": 10 }
        ]
      }
    ]
  }
}
